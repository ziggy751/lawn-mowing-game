{
  "name": "yardwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc -p worker/tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:cloud": "node scripts/dev-cloud.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:multiplayer": "node tests/multiplayer.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "lucide": "^0.468.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251115.0",
    "@types/node": "^24.19.2",
    "@types/three": "^0.181.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.56.1",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "wrangler": "4.47.0",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
